    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
      "--compile-commands-dir=${workspaceFolder}/build",
      "--all-scopes-completion",
      "--background-index",
      "--clang-tidy",
      "--clang-tidy-checks=bugprone-*,misc-*,performance-*,readability-*,-performance-unnecessary-value-param,-bugprone-crtp-constructor-accessibility",
      "--completion-parse=auto",
      "--completion-style=detailed",
      "--query-driver=/usr/bin/clang++-16",
      "--enable-config",
      "--fallback-style=Google",
      "--function-arg-placeholders=true",
      "--header-insertion-decorators",
      "--header-insertion=iwyu",
      "--log=verbose",
      "--pch-storage=memory",
      "--pretty",
      "--ranking-model=decision_forest",
      "-j=4"
    ],
    "clangd.fallbackFlags": [
      "-std=c++17",
      "-I/usr/local/include/eigen3",
      "--target=x86_64-pc-linux-gnu",
      "-pthread",
      "-stdlib=libc++"
    ],
    "clangd.checkUpdates": false,
    "clangd.onConfigChanged": "restart",
    "clangd.serverCompletionRanking": true,
    "clangd.detectExtensionConflicts": false,
    "editor.suggest.snippetsPreventQuickSuggestions": true,
    "clangd.path": "/usr/bin/clangd-16",
    "editor.inlayHints.enabled": "off",
    "lldb.commandCompletions": true,
    "lldb.dereferencePointers": true,
    "lldb.evaluateForHovers": true,
    "lldb.launch.expressions": "native",
    "lldb.showDisassembly": "never",
    "lldb.verboseLogging": true
}